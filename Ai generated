<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sama-English AI Translator (Sinama / Badjao)</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #0369a1 50%, #0f172a 100%);
            min-height: 100vh;
        }
        .ocean-glass {
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(56, 189, 248, 0.2);
        }
        .ocean-card {
            background: rgba(30, 41, 59, 0.7);
            border: 1px solid rgba(56, 189, 248, 0.15);
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: rgba(15, 23, 42, 0.5);
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #0284c7;
            border-radius: 3px;
        }
    </style>
</head>
<body class="text-slate-100 p-3 md:p-6 flex flex-col items-center min-h-screen">

    <!-- Header Section -->
    <header class="w-full max-w-5xl mb-6 text-center space-y-2">
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-400/30 text-cyan-300 text-xs font-semibold tracking-wide uppercase">
            <span>🌊 Sama Badjao Cultural Heritage Project</span>
        </div>
        <h1 class="text-3xl md:text-5xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-200 to-teal-300">
            Sinama ↔ English AI Translator
        </h1>
        <p class="text-slate-300 text-sm md:text-base max-w-2xl mx-auto">
          Made By Mr Nurfyied P. Abdilla. Bridging communication for the Sama (Badjao) language community with context-aware translation.
        </p>
    </header>

    <!-- Main Translator Workspace -->
    <main class="w-full max-w-5xl ocean-glass rounded-2xl shadow-2xl p-4 md:p-6 space-y-6">

        <!-- Controls / Mode Switcher -->
        <div class="flex flex-wrap justify-between items-center gap-4 pb-4 border-b border-slate-700/60">
            <div class="flex items-center space-x-3 bg-slate-900/80 p-1.5 rounded-xl border border-slate-700">
                <span id="srcLangLabel" class="px-4 py-1.5 rounded-lg bg-sky-600 text-white font-semibold text-sm shadow">
                    Sinama (Sama)
                </span>
                <button id="swapLangBtn" title="Swap Languages" class="p-2 text-cyan-400 hover:text-white hover:bg-slate-800 rounded-lg transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path></svg>
                </button>
                <span id="targetLangLabel" class="px-4 py-1.5 rounded-lg text-slate-300 font-semibold text-sm">
                    English
                </span>
            </div>

            <!-- Quick Info Badge -->
            <div class="text-xs text-cyan-300 flex items-center space-x-1 bg-cyan-950/40 px-3 py-1.5 rounded-lg border border-cyan-800/50">
                <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                <span>Supports Central, Northern, and Southern Sinama dialects</span>
            </div>
        </div>

        <!-- Translation Input / Output Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            
            <!-- Source Input Box -->
            <div class="ocean-card rounded-xl p-4 flex flex-col justify-between space-y-3">
                <div class="flex justify-between items-center text-xs text-slate-400 font-semibold uppercase tracking-wider">
                    <span id="inputBoxTitle">Input (Sinama)</span>
                    <button id="clearBtn" class="hover:text-pink-400 transition-colors">Clear</button>
                </div>
                <textarea id="inputText" rows="6" placeholder="Enter text in Sinama to translate..." 
                    class="w-full bg-transparent text-slate-100 placeholder-slate-500 focus:outline-none resize-none text-base md:text-lg"></textarea>
                
                <div class="flex justify-between items-center pt-2 border-t border-slate-700/40">
                    <button id="speakInputBtn" class="text-slate-400 hover:text-cyan-400 transition-colors p-1" title="Listen">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"></path></svg>
                    </button>
                    <button id="translateBtn" class="bg-gradient-to-r from-sky-500 to-teal-500 hover:from-sky-400 hover:to-teal-400 text-slate-950 font-bold px-6 py-2.5 rounded-lg shadow-lg hover:shadow-cyan-500/25 transition-all flex items-center space-x-2">
                        <span>Translate</span>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                    </button>
                </div>
            </div>

            <!-- Target Output Box -->
            <div class="ocean-card rounded-xl p-4 flex flex-col justify-between space-y-3 relative">
                <div class="flex justify-between items-center text-xs text-slate-400 font-semibold uppercase tracking-wider">
                    <span id="outputBoxTitle">Translation (English)</span>
                    <span id="loadingIndicator" class="hidden text-cyan-400 animate-pulse flex items-center space-x-1">
                        <svg class="animate-spin h-3.5 w-3.5 text-cyan-400" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                        <span>Translating...</span>
                    </span>
                </div>
                
                <div id="outputText" class="w-full h-full min-h-[140px] text-slate-200 text-base md:text-lg overflow-y-auto custom-scrollbar whitespace-pre-wrap">
                    <span class="text-slate-500 italic">Translation will appear here...</span>
                </div>

                <!-- Cultural Context / Nuance Notes -->
                <div id="culturalNotes" class="hidden bg-slate-900/60 border border-slate-700/60 rounded-lg p-2.5 text-xs text-cyan-200/90 space-y-1">
                    <div class="font-bold text-cyan-400 flex items-center space-x-1">
                        <span>💡 Cultural Note & Context:</span>
                    </div>
                    <p id="culturalNotesContent"></p>
                </div>

                <div class="flex justify-between items-center pt-2 border-t border-slate-700/40">
                    <button id="speakOutputBtn" class="text-slate-400 hover:text-cyan-400 transition-colors p-1" title="Listen">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"></path></svg>
                    </button>
                    <button id="copyBtn" class="text-slate-400 hover:text-cyan-400 transition-colors text-xs flex items-center space-x-1 border border-slate-700 hover:border-cyan-500/50 px-3 py-1 rounded-md bg-slate-800/50">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                        <span id="copyBtnText">Copy</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Common Sinama Phrases Quick-Buttons -->
        <div class="space-y-2">
            <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-wider flex items-center space-x-1">
                <span>💬 Quick Sinama Phrases & Vocabulary</span>
            </h3>
            <div class="flex flex-wrap gap-2" id="phraseButtons"></div>
        </div>

        <!-- Translation History Log -->
        <div class="space-y-3 pt-2">
            <div class="flex justify-between items-center">
                <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Recent Translations</h3>
                <button id="clearHistoryBtn" class="text-xs text-slate-500 hover:text-pink-400 transition-colors">Clear History</button>
            </div>
            <div id="historyList" class="space-y-2 max-h-48 overflow-y-auto custom-scrollbar pr-1">
                <p class="text-slate-500 text-xs italic">No recent translations yet.</p>
            </div>
        </div>

    </main>

    <footer class="mt-6 text-center text-xs text-slate-400 space-y-1">
        <p>Sama Badjao Sinama Dictionary & AI Translation Assistant</p>
        <p class="text-slate-500">Made by Criminologists • Preserving Indigenous Maritime Languages</p>
    </footer>

    <!-- Application Script -->
    <script>
        const quickPhrases = [
            { sinama: "Mabalas", english: "Thank you", note: "Common phrase used to express gratitude." },
            { sinama: "Aho", english: "Yes", note: "Standard affirmation." },
            { sinama: "Malingkat", english: "Beautiful / Pretty", note: "Used to describe people, ocean, or objects." },
            { sinama: "Mangan kitam", english: "Let us eat", note: "Hospitable invitation to share a meal." },
            { sinama: "Ingaan konno' nu?", english: "What is your name?", note: "Polite greeting to strangers." },
            { sinama: "Taha' t'ngah", english: "Deep sea / Ocean", note: "Reflects maritime life and culture." },
            { sinama: "Niya", english: "There is / Existing", note: "Indicates presence of something." },
            { sinama: "Halap subu", english: "Good morning", note: "Standard morning greeting." }
        ];

        let currentMode = 'sinama-to-english';
        let translationHistory = [];

        const inputText = document.getElementById('inputText');
        const outputText = document.getElementById('outputText');
        const culturalNotes = document.getElementById('culturalNotes');
        const culturalNotesContent = document.getElementById('culturalNotesContent');
        const translateBtn = document.getElementById('translateBtn');
        const loadingIndicator = document.getElementById('loadingIndicator');
        const swapLangBtn = document.getElementById('swapLangBtn');
        const srcLangLabel = document.getElementById('srcLangLabel');
        const targetLangLabel = document.getElementById('targetLangLabel');
        const inputBoxTitle = document.getElementById('inputBoxTitle');
        const outputBoxTitle = document.getElementById('outputBoxTitle');
        const clearBtn = document.getElementById('clearBtn');
        const copyBtn = document.getElementById('copyBtn');
        const copyBtnText = document.getElementById('copyBtnText');
        const phraseButtons = document.getElementById('phraseButtons');
        const historyList = document.getElementById('historyList');
        const clearHistoryBtn = document.getElementById('clearHistoryBtn');
        const speakInputBtn = document.getElementById('speakInputBtn');
        const speakOutputBtn = document.getElementById('speakOutputBtn');

        function renderQuickPhrases() {
            phraseButtons.innerHTML = '';
            quickPhrases.forEach(item => {
                const btn = document.createElement('button');
                btn.className = "text-xs bg-slate-800/80 hover:bg-sky-600/30 text-cyan-200 border border-slate-700 hover:border-cyan-400 px-3 py-1.5 rounded-lg transition-all text-left flex flex-col";
                btn.innerHTML = `<span class="font-semibold text-white">${item.sinama}</span><span class="text-[10px] text-slate-400">${item.english}</span>`;
                btn.onclick = () => {
                    if (currentMode !== 'sinama-to-english') toggleLanguageMode();
                    inputText.value = item.sinama;
                    handleTranslation();
                };
                phraseButtons.appendChild(btn);
            });
        }

        function toggleLanguageMode() {
            currentMode = currentMode === 'sinama-to-english' ? 'english-to-sinama' : 'sinama-to-english';
            if (currentMode === 'sinama-to-english') {
                srcLangLabel.innerText = 'Sinama (Sama)';
                targetLangLabel.innerText = 'English';
                inputBoxTitle.innerText = 'Input (Sinama)';
                outputBoxTitle.innerText = 'Translation (English)';
                inputText.placeholder = 'Enter text in Sinama to translate...';
            } else {
                srcLangLabel.innerText = 'English';
                targetLangLabel.innerText = 'Sinama (Sama)';
                inputBoxTitle.innerText = 'Input (English)';
                outputBoxTitle.innerText = 'Translation (Sinama)';
                inputText.placeholder = 'Enter text in English to translate...';
            }
            const prevOutput = outputText.innerText;
            if (prevOutput && !prevOutput.includes('Translation will appear here')) {
                inputText.value = prevOutput;
                outputText.innerHTML = '<span class="text-slate-500 italic">Translation will appear here...</span>';
                culturalNotes.classList.add('hidden');
            }
        }

        async function handleTranslation() {
            const query = inputText.value.trim();
            if (!query) return;

            loadingIndicator.classList.remove('hidden');
            translateBtn.disabled = true;
            culturalNotes.classList.add('hidden');

            try {
                // Calls your secure backend serverless function
                const response = await fetch('/api/translate', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ query, mode: currentMode })
                });

                const result = await response.json();

                if (result.translation) {
                    outputText.innerText = result.translation;
                    if (result.cultural_notes && result.cultural_notes.trim() !== '') {
                        culturalNotesContent.innerText = result.cultural_notes;
                        culturalNotes.classList.remove('hidden');
                    }
                    addToHistory(query, result.translation, currentMode);
                } else {
                    outputText.innerText = "Error: " + (result.error || "Unable to generate translation.");
                }
            } catch (err) {
                console.error("Translation Error:", err);
                outputText.innerText = "Connection error. Please check your network and try again.";
            } finally {
                loadingIndicator.classList.add('hidden');
                translateBtn.disabled = false;
            }
        }

        function addToHistory(source, target, mode) {
            const item = { source, target, mode, timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) };
            translationHistory.unshift(item);
            if (translationHistory.length > 10) translationHistory.pop();
            renderHistory();
        }

        function renderHistory() {
            if (translationHistory.length === 0) {
                historyList.innerHTML = '<p class="text-slate-500 text-xs italic">No recent translations yet.</p>';
                return;
            }
            historyList.innerHTML = '';
            translationHistory.forEach((item, index) => {
                const div = document.createElement('div');
                div.className = "bg-slate-900/70 border border-slate-800 rounded-lg p-2.5 text-xs flex justify-between items-center hover:border-slate-700 transition-colors";
                div.innerHTML = `
                    <div class="space-y-0.5">
                        <div class="flex items-center space-x-2">
                            <span class="text-cyan-400 font-semibold">${item.source}</span>
                            <span class="text-slate-500">→</span>
                            <span class="text-white">${item.target}</span>
                        </div>
                        <div class="text-[10px] text-slate-500">${item.mode === 'sinama-to-english' ? 'Sinama to English' : 'English to Sinama'} • ${item.timestamp}</div>
                    </div>
                    <button onclick="reuseHistory(${index})" class="text-cyan-400 hover:text-cyan-300 text-[11px] font-medium px-2 py-1 rounded bg-slate-800 border border-slate-700">Reuse</button>
                `;
                historyList.appendChild(div);
            });
        }

        window.reuseHistory = (index) => {
            const item = translationHistory[index];
            if (item.mode !== currentMode) toggleLanguageMode();
            inputText.value = item.source;
            outputText.innerText = item.target;
        };

        function speakText(text) {
            if (!('speechSynthesis' in window)) return;
            window.speechSynthesis.cancel();
            const utterance = new SpeechSynthesisUtterance(text);
            utterance.rate = 0.9;
            window.speechSynthesis.speak(utterance);
        }

        translateBtn.addEventListener('click', handleTranslation);
        swapLangBtn.addEventListener('click', toggleLanguageMode);
        clearBtn.addEventListener('click', () => {
            inputText.value = '';
            outputText.innerHTML = '<span class="text-slate-500 italic">Translation will appear here...</span>';
            culturalNotes.classList.add('hidden');
        });

        copyBtn.addEventListener('click', () => {
            const textToCopy = outputText.innerText;
            if (!textToCopy || textToCopy.includes('Translation will appear here')) return;
            const el = document.createElement('textarea');
            el.value = textToCopy;
            document.body.appendChild(el);
            el.select();
            document.execCommand('copy');
            document.body.removeChild(el);
            copyBtnText.innerText = 'Copied!';
            setTimeout(() => copyBtnText.innerText = 'Copy', 2000);
        });

        clearHistoryBtn.addEventListener('click', () => {
            translationHistory = [];
            renderHistory();
        });

        speakInputBtn.addEventListener('click', () => { if (inputText.value) speakText(inputText.value); });
        speakOutputBtn.addEventListener('click', () => {
            if (outputText.innerText && !outputText.innerText.includes('Translation will appear here')) speakText(outputText.innerText);
        });

        renderQuickPhrases();
    </script>
</body>
</html>
